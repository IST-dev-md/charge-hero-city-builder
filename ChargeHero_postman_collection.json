      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Station A\",\n  \"x\": 10,\n  \"y\": 20\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/stations",
          "host": ["{{baseUrl}}"],
          "path": ["api", "stations"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json && json.id) {",
              "  pm.collectionVariables.set('stationId', json.id);",
              "}"
            ]
          }
        }
      ]
    },
